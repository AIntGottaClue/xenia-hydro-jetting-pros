---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Callout from '../../components/Callout.astro';
import { guides } from '../../data/pages';
import { u } from '../../lib/utils';
const title = 'Hydro Jetting Guides | Xenia Hydro Jetting Pros';
const description = 'Plain guides on how hydro jetting works and how it compares with snaking for drain and sewer lines in Xenia, Ohio.';
---
<Base title={title} description={description} path="/guides/" crumbs={[{ name: 'Guides', path: '/guides/' }]}>
  <Hero headline="Hydro Jetting Guides in Xenia, OH" intro="Short guides to help you ask the right questions before any drain cleaning." location="Guides" crumbs={[{ href: '/guides/', label: 'Guides' }]} />
  <section class="content-section"><div class="content-inner">
    <div class="content-list">
      {guides.map((g, i) => <article class="content-item"><div class="item-number">{String(i + 1).padStart(2, '0')}</div><div><h3><a href={u(`/guides/${g.slug}/`)} style="color:inherit">{g.name}</a></h3><p>{g.blurb}</p></div></article>)}
    </div>
  </div></section>
  <Callout />
</Base>
