---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Callout from '../components/Callout.astro';
import { C, services } from '../data/pages';
import { neighborhoods } from '../data/neighborhoods';
import { faqSchema } from '../lib/seo';
import { u } from '../lib/utils';
const home = C['/'];
const [s1, s2, s3, s4] = home.sections;
const faqs = home.faqs;
const steps = [
  { t: 'Describe the drain problem', d: 'Note which fixtures are slow, whether sewage has backed up and if a prior cleaning helped.' },
  { t: 'Check the line', d: 'A qualified professional can locate the obstruction and assess whether the pipe can handle jetting.' },
  { t: 'Choose the work that fits', d: 'Cleaning may help with buildup. Roots in a broken joint or a collapsed section may also need repair.' },
];
---
<Base title={home.title} description={home.desc} path="/" extraSchema={[faqSchema(faqs)]}>
  <Hero headline={home.h1} intro={home.intro} location="Homepage" />
  <section class="content-section"><div class="content-inner split-section">
    <div>
      <h2 class="section-title">{s1.h}</h2>
      <p class="section-intro">{s1.ps[0]}</p>
      <div style="margin-top:27px"><a class="text-link" href={u('/guides/how-hydro-jetting-works/')}>See how hydro jetting works<span aria-hidden="true">&#8599;</span></a></div>
    </div>
    <div class="content-list">
      {services.map((s, i) => <article class="content-item"><div class="item-number">{String(i + 1).padStart(2, '0')}</div><div><h3><a href={u(`/services/${s.slug}/`)} style="color:inherit;text-decoration:none">{s.name}</a></h3><p>{s.blurb}</p></div></article>)}
    </div>
  </div></section>
  <section class="content-section" style="background:#eeece2"><div class="content-inner split-section">
    <div>
      <h2 class="section-title">{s2.h}</h2>
      {s2.ps.map((p) => <p class="section-intro" style="margin-bottom:14px" set:html={p} />)}
    </div>
    <div class="signal-panel"><div class="signal-big">Built around the inside of the pipe.</div></div>
  </div></section>
  <section class="content-section"><div class="content-inner">
    <h2 class="section-title">{s3.h}</h2>
    <p class="section-intro">Local history helps frame questions. It does not confirm a pipe problem or service coverage.</p>
    <div class="pill-grid" style="margin-top:24px">
      {neighborhoods.map((n) => <a class="pill" href={u(`/neighborhood/${n.slug}/`)}>{n.name}</a>)}
    </div>
    <h2 class="section-title" style="margin-top:56px">{s4.h}</h2>
    {s4.ps.map((p) => <p class="section-intro" style="margin-bottom:14px" set:html={p} />)}
    <div style="margin-top:20px"><a class="text-link" href={u('/guides/hydro-jetting-vs-snaking/')}>Hydro jetting vs snaking<span aria-hidden="true">&#8599;</span></a></div>
  </div></section>
  <section class="content-section" style="background:#eeece2"><div class="content-inner">
    <h2 class="section-title">From symptoms to a sensible next step.</h2>
    <div class="content-list">{steps.map((s, i) => <article class="content-item"><div class="item-number">{String(i + 1).padStart(2, '0')}</div><div><h3>{s.t}</h3><p>{s.d}</p></div></article>)}</div>
  </div></section>
  <section class="content-section"><div class="content-inner">
    <h2 class="section-title">Questions worth asking before hydro jetting.</h2>
    <div class="content-list">{faqs.map((f) => <article class="faq-row"><h3>{f.q}</h3><p>{f.a}</p></article>)}</div>
  </div></section>
  <Callout />
</Base>
